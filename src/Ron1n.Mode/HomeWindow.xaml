<Window x:Class="Ron1n.Mode.HomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="#0B101B" XYFocusKeyboardNavigation="Enabled">
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.76" IsHitTestVisible="False" />
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                    <GradientStop Color="#FB0B101B" Offset="0" />
                    <GradientStop Color="#D50B101B" Offset="0.42" />
                    <GradientStop Color="#290B101B" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop x:Name="Ambient" Color="#404CE1C2" Offset="0" />
                    <GradientStop Color="#000B101B" Offset="0.8" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Grid x:Name="Home" Padding="42,28,42,26" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="RON1N MODE" CharacterSpacing="180" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="InputStatus" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,12,0" />
                    <Button Content="Impostazioni" Click="OpenSettings" />
                    <Button Content="Desktop" Click="ShowDesktop" />
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False">
                <StackPanel x:Name="Cards" Orientation="Horizontal" Spacing="12" />
            </ScrollViewer>
            <StackPanel x:Name="Hero" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                        MaxWidth="720" Spacing="14">
                <Border x:Name="AccentBar" Height="4" Width="54" CornerRadius="2" HorizontalAlignment="Left" />
                <TextBlock x:Name="TitleText" FontSize="66" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Description" FontSize="21" Opacity="0.82" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                <HyperlinkButton x:Name="CatalogSource" Visibility="Collapsed" Padding="0" />
                <TextBlock x:Name="SessionStatus" FontSize="15" Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="Play" Padding="24,10" FontSize="18" FontWeight="SemiBold" Click="PlayGame" />
                    <Button x:Name="More" Content="•••" AutomationProperties.Name="Opzioni del gioco" Click="OpenGameMenu" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="Status" Grid.Row="3" TextWrapping="Wrap" Opacity="0.84" />
        </Grid>
        <Grid x:Name="Settings" Background="#F20D1422" Visibility="Collapsed" Padding="42,34" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="18">
                <Button Content="‹  Home" Click="CloseSettings" VerticalAlignment="Center" />
                <TextBlock Text="Impostazioni" FontSize="38" FontWeight="SemiBold" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListView x:Name="Categories" SelectionChanged="SettingsCategoryChanged"
                          HorizontalContentAlignment="Stretch" />
                <Border Grid.Column="1" Background="#CF1A2436" CornerRadius="16" Padding="25">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsTabStop="False">
                        <StackPanel x:Name="SettingsRows" Spacing="14" MaxWidth="820" HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                </Border>
            </Grid>
            <TextBlock x:Name="SettingsStatus" Grid.Row="2" Opacity="0.85" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
