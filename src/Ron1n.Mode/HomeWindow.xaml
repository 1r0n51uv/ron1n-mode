<Window x:Class="Ron1n.Mode.HomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="#07090D" XYFocusKeyboardNavigation="Enabled">
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.82,0.12" GradientOrigin="0.82,0.12" RadiusX="0.72" RadiusY="0.95">
                    <GradientStop Color="#8034A482" Offset="0" />
                    <GradientStop Color="#58214667" Offset="0.48" />
                    <GradientStop Color="#0007090D" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Image x:Name="BackdropA" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" />
        <Image x:Name="BackdropB" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" />
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                    <GradientStop Color="#F20B101B" Offset="0" />
                    <GradientStop Color="#B80B101B" Offset="0.42" />
                    <GradientStop Color="#170B101B" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop x:Name="Ambient" Color="#404CE1C2" Offset="0" />
                    <GradientStop Color="#000B101B" Offset="0.8" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#ED090D17" Offset="0"/>
                    <GradientStop Color="#00090D17" Offset="0.42"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Grid x:Name="Home" Padding="46,30,46,22" RowSpacing="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border x:Name="BrandAccent" Background="#FF6EE6D3" Width="4" Height="23" CornerRadius="2"/>
                    <TextBlock Text="RON1N MODE" CharacterSpacing="205" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource GlassCapsule}" Padding="16,5,5,5">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="InputStatus" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,12,0" />
                    <Button x:Name="SettingsAction" Style="{StaticResource ConsoleNavButton}" Click="OpenSettings"
                            AutomationProperties.Name="Impostazioni" ToolTipService.ToolTip="Impostazioni">
                        <FontIcon Glyph="&#xE713;" FontSize="21"/>
                    </Button>
                    <Button x:Name="DesktopAction" Style="{StaticResource ConsoleNavButton}" Click="ShowDesktop"
                            AutomationProperties.Name="Desktop" ToolTipService.ToolTip="Torna al desktop">
                        <FontIcon Glyph="&#xE7F4;" FontSize="21"/>
                    </Button>
                  </StackPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Row="2">
                <StackPanel x:Name="Hero" HorizontalAlignment="Left" MaxWidth="760" Spacing="8">
                    <Border x:Name="AccentBar" Height="4" Width="54" CornerRadius="2" HorizontalAlignment="Left" />
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="64" FontWeight="Bold"
                               CharacterSpacing="-30" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="GameDetails" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="Description" FontSize="20" Opacity="0.90" TextWrapping="Wrap" MaxLines="3"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="SessionStatus" FontSize="15" Opacity="0.8" VerticalAlignment="Center" />
                        <Button x:Name="More" Style="{StaticResource ConsoleNavButton}" Width="40" Height="40" CornerRadius="20"
                                AutomationProperties.Name="Opzioni del gioco" Click="OpenGameMenu">
                            <FontIcon Glyph="&#xE712;" FontSize="17"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False">
                    <Border Padding="16,19">
                        <StackPanel x:Name="Cards" Orientation="Horizontal" Spacing="20" />
                    </Border>
                </ScrollViewer>
            </StackPanel>
            <TextBlock x:Name="Status" Grid.Row="3" TextWrapping="Wrap" Opacity="0.84" />
        </Grid>
        <Grid x:Name="Settings" Background="#D207090D" Visibility="Collapsed" Padding="42,34" RowSpacing="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="18">
                <Button x:Name="SettingsBack" Style="{StaticResource ConsoleNavButton}" Click="CloseSettings" VerticalAlignment="Center"
                        AutomationProperties.Name="Torna alla home" ToolTipService.ToolTip="Torna alla home">
                    <FontIcon Glyph="&#xE72B;" FontSize="21"/>
                </Button>
                <TextBlock Text="Impostazioni" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="42"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsRail" Width="286" />
                    <ColumnDefinition Width="*" MaxWidth="1060" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Hidden" IsTabStop="False">
                    <StackPanel x:Name="Categories" Spacing="5" Padding="7,8" />
                </ScrollViewer>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                    <StackPanel x:Name="SettingsRows" Spacing="12" Padding="12,8,12,22" />
                </ScrollViewer>
            </Grid>
            <TextBlock x:Name="SettingsStatus" Grid.Row="2" Opacity="0.85" TextWrapping="Wrap" />
        </Grid>
        <Grid x:Name="SettingsPicker" Visibility="Collapsed" Background="#E607090D" TabFocusNavigation="Cycle" Padding="28">
            <Grid MaxWidth="820" VerticalAlignment="Center" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SettingsPickerTitle" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="32"
                           FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" />
                <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                    <StackPanel x:Name="SettingsPickerOptions" Spacing="10" Padding="12,12" />
                </ScrollViewer>
                <Button Grid.Row="2" x:Name="SettingsPickerBack" Style="{StaticResource ConsoleNavButton}"
                        HorizontalAlignment="Center" Click="CancelSettingsPicker" AutomationProperties.Name="Indietro"
                        ToolTipService.ToolTip="Indietro">
                    <FontIcon Glyph="&#xE72B;" FontSize="21" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
