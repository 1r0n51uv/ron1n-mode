<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Glass brushes and control templates adapted from 1r0n51uv/consolemode (AGPL-3.0). -->
    <Color x:Key="SystemAccentColor">#2FB88C</Color>
    <Color x:Key="SystemAccentColorLight1">#4FCFA3</Color>
    <Color x:Key="SystemAccentColorLight2">#6FDDB8</Color>
    <Color x:Key="SystemAccentColorLight3">#9BEACF</Color>
    <FontFamily x:Key="ConsoleFontFamily">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
    <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="ConsoleFontFamily"/>
    <SolidColorBrush x:Key="ConsoleAccentBrush" Color="#6FDDB8"/>
    <AcrylicBrush x:Key="GlassFill" TintColor="#0D141D" TintOpacity="0.42" TintLuminosityOpacity="0.6" FallbackColor="#E6131A24"/>

    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33FFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.38"/>
        <GradientStop Color="#00FFFFFF" Offset="0.62"/>
        <GradientStop Color="#12FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8CFFFFFF" Offset="0"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.4"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.62"/>
        <GradientStop Color="#59FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassEdgeFocused" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#80FFFFFF" Offset="0.45"/>
        <GradientStop Color="#4DFFFFFF" Offset="0.6"/>
        <GradientStop Color="#D9FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="GlassCapsule" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="CornerRadius" Value="28"/>
    </Style>

    <ControlTemplate x:Key="ConsoleSurfaceTemplate" TargetType="Button">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale"/>
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                        <VisualTransition GeneratedDuration="0:0:0.2">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                    <VisualState x:Name="Focused">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="EdgeFocus" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="ShineShift" Storyboard.TargetProperty="X" From="-1.4" To="1.4" Duration="0:0:0.9" EnableDependentAnimation="True">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" Duration="0:0:0.9">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="1"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border Background="{StaticResource GlassFill}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border Background="{StaticResource GlassSheen}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
            <Border x:Name="Hover" Opacity="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
            <Border x:Name="Shine" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="ShineShift" X="-1.4"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#00FFFFFF" Offset="0.3"/>
                        <GradientStop Color="#40FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.7"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw"/>
            <Border BorderBrush="{StaticResource GlassEdge}" BorderThickness="1.2" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
            <Border x:Name="EdgeFocus" Opacity="0" BorderBrush="{StaticResource GlassEdgeFocused}" BorderThickness="2.5" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
            <Border x:Name="Glow" Opacity="0" Margin="-7" BorderBrush="#2EFFFFFF" BorderThickness="6" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ConsoleFlatTemplate" TargetType="Button">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale"/>
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                        <VisualTransition GeneratedDuration="0:0:0.2">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                    <VisualState x:Name="Focused">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FocusFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border x:Name="Hover" Opacity="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
            <Border x:Name="FocusFill" Opacity="0" Background="#2EFFFFFF" BorderBrush="{StaticResource GlassEdgeFocused}" BorderThickness="1.5"
                    CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="ConsoleCard" TargetType="Button">
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="MinHeight" Value="120"/>
        <Setter Property="Padding" Value="22,18"/>
        <Setter Property="CornerRadius" Value="26"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="#0AFFFFFF"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Template" Value="{StaticResource ConsoleSurfaceTemplate}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
    </Style>

    <Style x:Key="LaunchTileButton" TargetType="Button" BasedOn="{StaticResource ConsoleCard}">
        <Setter Property="Width" Value="144"/>
        <Setter Property="Height" Value="176"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>

    <Style x:Key="ConsoleNavButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource ConsoleSurfaceTemplate}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="26"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
    </Style>

    <Style x:Key="ConsoleRow" TargetType="Button" BasedOn="{StaticResource ConsoleCard}">
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="Height" Value="72"/>
        <Setter Property="Padding" Value="28,0"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Background" Value="#0AFFFFFF"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ConsoleCategory" TargetType="Button" BasedOn="{StaticResource ConsoleRow}">
        <Setter Property="Template" Value="{StaticResource ConsoleFlatTemplate}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="60"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="CornerRadius" Value="30"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="ConsoleTextField" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource GlassFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="MinWidth" Value="310"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style x:Key="ConsoleDialogButton" TargetType="Button" BasedOn="{StaticResource ConsoleCard}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
